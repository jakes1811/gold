SELECT column_name, data_type
FROM information_schema.columns
WHERE table_schema = 'fintel_gold'
  AND table_name = 'gold_news_sentiment'
  AND column_name = 'event_time';


ALTER TABLE fintel_gold.gold_news_sentiment
ADD COLUMN IF NOT EXISTS event_time TIMESTAMPTZ;

CREATE INDEX IF NOT EXISTS idx_gold_news_sentiment_symbol_event_time
ON fintel_gold.gold_news_sentiment (symbol, event_time DESC);
