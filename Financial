# ============================================================
# RESULT STRUCTURE
# ============================================================

@dataclass
class FinancialNewsResult:

    accepted: bool
    category: str
    score: int
    reason: str


# ============================================================
# REGEX HELPER
# ============================================================

def contains_pattern(text, patterns):
    """Check whether any regular expression matches."""

    return any(
        re.search(pattern, text, re.IGNORECASE)
        for pattern in patterns
    )


# ============================================================
# CATEGORY IDENTIFICATION
# ============================================================

def find_financial_categories(text):
    """Identify matching financial news categories."""

    matched_categories = []

    for category, keywords in FINANCIAL_CATEGORIES.items():

        if any(
            keyword.lower() in text
            for keyword in keywords
        ):
            matched_categories.append(category)

    return matched_categories


# ============================================================
# PROMOTIONAL VALIDATION
# ============================================================

def is_promotional(headline, description=""):
    """
    Identify explicit advertisements and stock-picking
    promotional content.

    Genuine reported analyst recommendations are not
    rejected simply because they contain Buy/Sell language.
    """

    headline = clean_text(headline).lower()
    description = clean_text(description).lower()

    # Check headline and description for explicit promotions.
    if contains_pattern(headline, PROMOTIONAL_PATTERNS):
        return True

    if contains_pattern(description, PROMOTIONAL_PATTERNS):
        return True

    # Reject generic stock-picking roundups.
    if contains_pattern(headline, GENERIC_ROUNDUP_PATTERNS):
        return True

    return False


# ============================================================
# FINANCIAL NEWS FILTER
# ============================================================

def evaluate_financial_news(
    headline,
    description="",
    publisher=""
):
    """
    Evaluate whether an article is meaningful financial news.

    Company relevance must be checked separately using
    company_filter.py.

    Returns FinancialNewsResult.
    """

    headline = clean_text(headline)
    description = clean_text(description)
    publisher = clean_text(publisher)

    headline_lower = headline.lower()
    description_lower = description.lower()

    combined_text = (
        f"{headline_lower} {description_lower}"
    )

    # --------------------------------------------------------
    # 1. Reject promotional content
    # --------------------------------------------------------

    if is_promotional(headline, description):

        return FinancialNewsResult(
            accepted=False,
            category="promotional",
            score=0,
            reason=(
                "Advertisement, stock recommendation "
                "or promotional content detected"
            )
        )

    # --------------------------------------------------------
    # 2. Identify financial categories
    # --------------------------------------------------------

    categories = find_financial_categories(
        combined_text
    )

    if not categories:

        return FinancialNewsResult(
            accepted=False,
            category="unclassified",
            score=0,
            reason="No meaningful financial news signals found"
        )

    # --------------------------------------------------------
    # 3. Reject generic market roundups
    # --------------------------------------------------------

    is_generic_roundup = contains_pattern(
        headline_lower,
        GENERIC_ROUNDUP_PATTERNS
    )

    has_company_specific_analysis = any(
        category in categories
        for category in [
            "financial_performance",
            "business_developments",
            "corporate_actions",
            "regulatory_legal",
            "management_changes",
            "operational_developments",
            "risk_and_disruptions",
        ]
    )

    if is_generic_roundup and not has_company_specific_analysis:

        return FinancialNewsResult(
            accepted=False,
            category="generic_market_roundup",
            score=0,
            reason=(
                "Generic market roundup without "
                "specific company development"
            )
        )

    # --------------------------------------------------------
    # 4. Calculate relevance score
    # --------------------------------------------------------

    # Each category contributes its weight only once.
    score = sum(
        CATEGORY_WEIGHTS.get(category, 0)
        for category in categories
    )

    # --------------------------------------------------------
    # 5. Minimum financial relevance threshold
    # --------------------------------------------------------

    if score < 2:

        return FinancialNewsResult(
            accepted=False,
            category=", ".join(categories),
            score=score,
            reason="Financial relevance score too low"
        )

    # --------------------------------------------------------
    # 6. Accept article
    # --------------------------------------------------------

    return FinancialNewsResult(
        accepted=True,
        category=", ".join(categories),
        score=score,
        reason="Meaningful financial news signals identified"
    )


# ============================================================
# SIMPLE PUBLIC INTERFACE
# ============================================================

def is_financially_relevant(
    headline,
    description="",
    publisher=""
):
    """Return True when an article passes financial filtering."""

    result = evaluate_financial_news(
        headline,
        description,
        publisher
    )

    return result.accepted
